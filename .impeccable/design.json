      "css": ".ds-progress{display:flex;align-items:center;gap:9px;color:var(--ink,#484738);font:14px 'DM Sans',sans-serif;font-variant-numeric:tabular-nums;white-space:nowrap}.ds-progress svg{width:22px;height:22px}.ds-divider{color:#8c8473}@media(max-width:600px){.ds-progress{gap:6px;font-size:13px}.ds-progress svg{width:20px;height:20px}}"
